{
  "course_id": "lab_af_demo",
  "course_title": "Lab demo: BGP address-family",
  "chapters": [
    {
      "chapter_id": "chap_lab_af_demo",
      "chapter_title": "3.0 Lab demo address-family",
      "nodes": [
        {
          "node_id": "node_lab_af_demo",
          "node_title": "BGP address-family",
          "icon": "router.svg",
          "questions": [
            {
              "type": "lab",
              "prompt": "Kích hoạt neighbor 10.0.12.2 trong address-family ipv4 và quảng bá mạng 10.1.1.0/24.",
              "explanation": "Khi đã tắt bgp default ipv4-unicast, neighbor chỉ trao đổi route IPv4 sau khi được activate trong address-family ipv4. Lệnh network cũng đặt trong address-family.",
              "lab": {
                "version": 1,
                "use": [
                  "bgp",
                  "af"
                ],
                "scenario": "R1 (AS 65001) đã có neighbor eBGP 10.0.12.2 (AS 65002) nhưng đã tắt bgp default ipv4-unicast.",
                "topology": {
                  "links": [
                    {
                      "a": "R1:Gi0/0",
                      "b": "R2:Gi0/0",
                      "label": "10.0.12.0/30"
                    }
                  ]
                },
                "tasks": [
                  {
                    "id": "t1",
                    "text": "Activate neighbor 10.0.12.2 trong address-family ipv4"
                  },
                  {
                    "id": "t2",
                    "text": "Quảng bá 10.1.1.0/24 bằng network trong address-family ipv4"
                  }
                ],
                "max_hints": 2,
                "hints": [
                  "Vào router bgp 65001 rồi mở address-family ipv4",
                  "neighbor ... activate và network ... mask ... đều nằm trong address-family"
                ],
                "allow_help": true,
                "devices": [
                  {
                    "id": "R1",
                    "kind": "router",
                    "start_mode": "privileged",
                    "config": [
                      "hostname R1",
                      "!",
                      "interface GigabitEthernet0/0",
                      " ip address 10.0.12.1 255.255.255.252",
                      "!",
                      "router bgp 65001",
                      " bgp router-id 1.1.1.1",
                      " no bgp default ipv4-unicast",
                      " neighbor 10.0.12.2 remote-as 65002"
                    ],
                    "show": [
                      {
                        "cmd": "show ip bgp summary",
                        "default": "BGP router identifier 1.1.1.1, local AS number 65001\nNeighbor        V           AS State/PfxRcd\n10.0.12.2       4        65002 Idle"
                      }
                    ]
                  }
                ],
                "goals": [
                  {
                    "task": "t1",
                    "device": "R1",
                    "in": "router bgp 65001 > address-family ipv4",
                    "has": [
                      "neighbor 10.0.12.2 activate"
                    ]
                  },
                  {
                    "task": "t2",
                    "device": "R1",
                    "in": "router bgp 65001 > address-family ipv4",
                    "has": [
                      "network 10.1.1.0 mask 255.255.255.0"
                    ]
                  }
                ],
                "solution": [
                  {
                    "device": "R1",
                    "commands": [
                      "router bgp 65001",
                      "address-family ipv4",
                      "neighbor 10.0.12.2 activate",
                      "network 10.1.1.0 mask 255.255.255.0",
                      "exit-address-family"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}